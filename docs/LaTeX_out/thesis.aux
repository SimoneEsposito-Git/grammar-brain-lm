\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Prediction performance of the baseline contextual model across subjects and modalities.} Voxelwise encoding models were used to estimate the relationship between unmasked GPT-2 Layer 8 contextual embeddings and BOLD responses for each individual participant. The top two rows display the model prediction accuracy ($r$) for the reading modality, and the bottom two rows display the results for the listening modality. Accuracy was computed as the Pearson's correlation between the predicted and actual BOLD responses for a held-out validation story. Each flatmap represents one participant (S1--S9, excluding S4). Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). This figure demonstrates that contextual embeddings accurately predict brain activity across a large portion of the cortex in both modalities for all participants.}}{20}{figure.caption.27}\protected@file@percent }
\newlabel{fig:baseline}{{S1}{20}{\textbf {Prediction performance of the baseline contextual model across subjects and modalities.} Voxelwise encoding models were used to estimate the relationship between unmasked GPT-2 Layer 8 contextual embeddings and BOLD responses for each individual participant. The top two rows display the model prediction accuracy ($r$) for the reading modality, and the bottom two rows display the results for the listening modality. Accuracy was computed as the Pearson's correlation between the predicted and actual BOLD responses for a held-out validation story. Each flatmap represents one participant (S1--S9, excluding S4). Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). This figure demonstrates that contextual embeddings accurately predict brain activity across a large portion of the cortex in both modalities for all participants}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Noun and verb sensitivity across subjects using lexical embeddings.} Voxelwise encoding models were fit using noun-masked and verb-masked English1000 lexical embeddings alongside low-level features. The drop in predictive performance relative to the unmodified English1000 baseline is shown for both reading (top two rows) and listening (bottom two rows) modalities. Sensitivity is plotted using a bivariate color map where \textbf  {blue} indicates a greater drop for the noun-masked model and \textbf  {orange} indicates a greater drop for the verb-masked model. Each pair of flatmaps represents an individual participant (S1--S9, excluding S4). Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). The patterns of sensitivity are similar to those observed with GPT-2-based contextual embeddings, suggesting that the observed clusters reflect a genuine neural signal rather than an artifact of the language model architecture.}}{21}{figure.caption.28}\protected@file@percent }
\newlabel{fig:lexical}{{S2}{21}{\textbf {Noun and verb sensitivity across subjects using lexical embeddings.} Voxelwise encoding models were fit using noun-masked and verb-masked English1000 lexical embeddings alongside low-level features. The drop in predictive performance relative to the unmodified English1000 baseline is shown for both reading (top two rows) and listening (bottom two rows) modalities. Sensitivity is plotted using a bivariate color map where \textbf {blue} indicates a greater drop for the noun-masked model and \textbf {orange} indicates a greater drop for the verb-masked model. Each pair of flatmaps represents an individual participant (S1--S9, excluding S4). Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). The patterns of sensitivity are similar to those observed with GPT-2-based contextual embeddings, suggesting that the observed clusters reflect a genuine neural signal rather than an artifact of the language model architecture}{figure.caption.28}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Contextual embedding pipeline with POS attention masking.} A stimulus sentence is passed through a noun filter, which uses spaCy POS tags to generate an attention mask (green: unmasked; red: masked). The masked input is fed into GPT-2, whose hidden state at Layer 8, $H_8\in \mathbb  {R}^{L \times 768}$, is then averaged over unmasked tokens to produce a single contextualized embedding $e_w \in \mathbb  {R}^{768}$ for the target word.}}{7}{figure.caption.11}\protected@file@percent }
\abx@aux@cite{0}{schrimpf_neural_2021}
\abx@aux@segm{0}{0}{schrimpf_neural_2021}
\abx@aux@cite{0}{jain_incorporating_2018}
\abx@aux@segm{0}{0}{jain_incorporating_2018}
\abx@aux@page{20}{8}
\abx@aux@page{21}{8}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Parts of Speech sensitivity across the brain using all POS}: nouns, verbs, adjectives, adverbs, pronouns and interjections. \textbf  {a} Voxelwise model r values in the listening modality using POS-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy. The drop in accuracy for each POS was then ranked for each voxel individually and the greatest drop was plotted on the flatmap in the respective color \textbf  {b} Voxels are colored using the same procedure as in \textbf  {a} but for the reading modality. \textbf  {c} Distribution of POS tags in the training stories and the validation story. The percentage of each POS tag was calculated by counting the number of words with that tag and dividing it by the total number of words in the story. The average percentage across the 10 training stories is plotted on the left, while the percentage for the validation story is plotted on the right.}}{10}{figure.caption.15}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pos_sensitivity}{{2}{10}{\textbf {Parts of Speech sensitivity across the brain using all POS}: nouns, verbs, adjectives, adverbs, pronouns and interjections. \textbf {a} Voxelwise model r values in the listening modality using POS-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy. The drop in accuracy for each POS was then ranked for each voxel individually and the greatest drop was plotted on the flatmap in the respective color \textbf {b} Voxels are colored using the same procedure as in \textbf {a} but for the reading modality. \textbf {c} Distribution of POS tags in the training stories and the validation story. The percentage of each POS tag was calculated by counting the number of words with that tag and dividing it by the total number of words in the story. The average percentage across the 10 training stories is plotted on the left, while the percentage for the validation story is plotted on the right}{figure.caption.15}{}}
\pgfsyspdfmark {pgfid2}{23132152}{39427382}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Noun and verb sensitivity across subjects in the listening modality.} Voxelwise model r values in the listening modality for noun-masked and verb-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy, then plotted using a bivariate color map. Blue points indicate a greater drop in performance for the noun-masked model while orange points indicate a greater drop for the verb-masked model. Grayscale points indicate a similar drop for both models. The large panel \textbf  {a} shows the results for subject 07, while the smaller panels \textbf  {b} show the results for the remaining subjects.}}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:noun_verb}{{3}{11}{\textbf {Noun and verb sensitivity across subjects in the listening modality.} Voxelwise model r values in the listening modality for noun-masked and verb-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy, then plotted using a bivariate color map. Blue points indicate a greater drop in performance for the noun-masked model while orange points indicate a greater drop for the verb-masked model. Grayscale points indicate a similar drop for both models. The large panel \textbf {a} shows the results for subject 07, while the smaller panels \textbf {b} show the results for the remaining subjects}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Relative reliance on nouns versus verbs across regions of interest (ROIs).} Points indicate the proportion of the total performance drop within each ROI attributable to masking the preferred word class. Values are computed by summing the voxel-wise performance decrements (baseline $>$ masked condition) for nouns and verbs, and expressing each as a percentage of the total combined decrement. The dashed line at 50\% represents equal reliance on both grammatical classes. Values further from the center indicate a stronger magnitude-weighted dominance. Error bars represent ± 1 standard deviation across n subjects.}}{12}{figure.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Theoretical Accounts of Cortical Sensitivity to Nouns and Verbs}}{13}{table.caption.21}\protected@file@percent }
\newlabel{tab:noun_verb_theories}{{1}{13}{Theoretical Accounts of Cortical Sensitivity to Nouns and Verbs}{table.caption.21}{}}

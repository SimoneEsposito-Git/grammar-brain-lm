\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Noun and verb sensitivity across subjects in the listening modality.} Voxelwise model r values in the listening modality for noun-masked and verb-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy, then plotted using a bivariate color map. Blue points indicate a greater drop in performance for the noun-masked model while orange points indicate a greater drop for the verb-masked model. Grayscale points indicate a similar drop for both models. The large panel \textbf  {a} shows the results for subject 07, while the smaller panels \textbf  {b} show the results for the remaining subjects.}}{12}{figure.caption.23}\protected@file@percent }
\newlabel{fig:noun_verb}{{3}{12}{\textbf {Noun and verb sensitivity across subjects in the listening modality.} Voxelwise model r values in the listening modality for noun-masked and verb-masked contextual embeddings were subtracted from the r values of the baseline contextual model to get the drop in accuracy, then plotted using a bivariate color map. Blue points indicate a greater drop in performance for the noun-masked model while orange points indicate a greater drop for the verb-masked model. Grayscale points indicate a similar drop for both models. The large panel \textbf {a} shows the results for subject 07, while the smaller panels \textbf {b} show the results for the remaining subjects}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Noun and verb sensitivity across language ROIs.} Each point indicates the mean drop in predictive performance $\Delta r = r_{\text  {baseline}} - r_{\text  {masked}}$ for the noun-masked (blue) and verb-masked (orange) models, averaged across subjects within each ROI. For each subject, $\Delta r$ was computed as the mean positive drop across voxels within the ROI that survived FDR correction. Error bars represent $\pm 1$ SEM across subjects. ROIs are ordered by their mean $\Delta r$ in the listening modality.}}{13}{figure.caption.24}\protected@file@percent }
\newlabel{fig:roi_dominance}{{4}{13}{\textbf {Noun and verb sensitivity across language ROIs.} Each point indicates the mean drop in predictive performance $\Delta r = r_{\text {baseline}} - r_{\text {masked}}$ for the noun-masked (blue) and verb-masked (orange) models, averaged across subjects within each ROI. For each subject, $\Delta r$ was computed as the mean positive drop across voxels within the ROI that survived FDR correction. Error bars represent $\pm 1$ SEM across subjects. ROIs are ordered by their mean $\Delta r$ in the listening modality}{figure.caption.24}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Contextual embedding pipeline with POS attention masking.} A narrative stimulus is processed via a part-of-speech (POS) tagger to generate category-specific attention masks. \textbf  {Green} indicates unmasked tokens, while \textbf  {red} indicates tokens selectively masked based on grammatical class. The resulting masked input is fed into GPT-2. Hidden states at Layer 8 ($H_{8} \in \mathbb  {R}^{L \times 768}$) are averaged across unmasked tokens to produce an information-restricted contextualized embedding ($e_{w} \in \mathbb  {R}^{768}$) for each target word.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:embedding_pipeline}{{1}{7}{\textbf {Contextual embedding pipeline with POS attention masking.} A narrative stimulus is processed via a part-of-speech (POS) tagger to generate category-specific attention masks. \textbf {Green} indicates unmasked tokens, while \textbf {red} indicates tokens selectively masked based on grammatical class. The resulting masked input is fed into GPT-2. Hidden states at Layer 8 ($H_{8} \in \mathbb {R}^{L \times 768}$) are averaged across unmasked tokens to produce an information-restricted contextualized embedding ($e_{w} \in \mathbb {R}^{768}$) for each target word}{figure.caption.10}{}}
\abx@aux@cite{0}{nunez_voxelwise_2019}
\abx@aux@segm{0}{0}{nunez_voxelwise_2019}
\abx@aux@page{42}{9}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Grammatical category sensitivity across the cortical surface.} A voxelwise encoding model (VEM) was used to estimate sensitivity to six parts of speech: nouns, verbs, adjectives, adverbs, pronouns, and interjections. \textbf  {a}, Drop in predictive performance ($r$) in the listening modality. Values were computed by subtracting POS-masked model correlations from the unmasked baseline model. Colors represent the category that yielded the greatest accuracy drop for each individual voxel. Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). \textbf  {b}, POS sensitivity for the reading modality, computed using the same procedure as in \textbf  {a}. \textbf  {c}, Distribution of POS tags in the training and validation datasets. Percentages reflect the frequency of each category relative to the total word count in the narrative stories}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:pos_sensitivity}{{2}{10}{\textbf {Grammatical category sensitivity across the cortical surface.} A voxelwise encoding model (VEM) was used to estimate sensitivity to six parts of speech: nouns, verbs, adjectives, adverbs, pronouns, and interjections. \textbf {a}, Drop in predictive performance ($r$) in the listening modality. Values were computed by subtracting POS-masked model correlations from the unmasked baseline model. Colors represent the category that yielded the greatest accuracy drop for each individual voxel. Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). \textbf {b}, POS sensitivity for the reading modality, computed using the same procedure as in \textbf {a}. \textbf {c}, Distribution of POS tags in the training and validation datasets. Percentages reflect the frequency of each category relative to the total word count in the narrative stories}{figure.caption.15}{}}
\abx@aux@cite{0}{deniz_representation_2019}
\abx@aux@segm{0}{0}{deniz_representation_2019}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Noun and verb sensitivity across subjects and stimulus modalities.} Voxelwise model prediction accuracies ($r$) for noun-masked and verb-masked contextual embeddings were compared against the baseline contextual model to calculate category-specific drops in performance. \textbf  {a}, Results for one participant (S7) are shown on the flattened cortical surface for both reading (left) and listening (right) modalities. Sensitivity is plotted using a bivariate color map. \textbf  {Blue} points indicate a greater drop in performance for the noun-masked model, while \textbf  {orange} points indicate a greater drop for the verb-masked model. \textbf  {Grayscale} points indicate a similar drop for both models. Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). \textbf  {b}, Noun and verb sensitivity maps for the remaining participants (S1--S9, excluding S4) across both reading and listening modalities. The spatial distribution of noun- and verb-sensitive clusters is largely invariant to stimulus modality.}}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:noun_verb}{{3}{12}{\textbf {Noun and verb sensitivity across subjects and stimulus modalities.} Voxelwise model prediction accuracies ($r$) for noun-masked and verb-masked contextual embeddings were compared against the baseline contextual model to calculate category-specific drops in performance. \textbf {a}, Results for one participant (S7) are shown on the flattened cortical surface for both reading (left) and listening (right) modalities. Sensitivity is plotted using a bivariate color map. \textbf {Blue} points indicate a greater drop in performance for the noun-masked model, while \textbf {orange} points indicate a greater drop for the verb-masked model. \textbf {Grayscale} points indicate a similar drop for both models. Voxels whose model prediction was not statistically significant are shown in gray ($p>0.05$, FDR corrected). \textbf {b}, Noun and verb sensitivity maps for the remaining participants (S1--S9, excluding S4) across both reading and listening modalities. The spatial distribution of noun- and verb-sensitive clusters is largely invariant to stimulus modality}{figure.caption.17}{}}
\abx@aux@page{43}{12}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Quantifying noun and verb sensitivity across language-selective regions of interest (ROIs).} Each point represents the mean $\Delta r = r_\text  {baseline} - r_\text  {masked}$ within significant voxels ($p<0.05$, FDR corrected) with $\Delta r \geq 0$, for noun-masked (\textbf  {blue}) and verb-masked (\textbf  {orange}) models, then averaged across participants. Error bars represent $\pm 1$ SEM across eight participants (S1--S9, excluding S4). ROIs are ordered by their mean $\Delta r$ in the listening modality.}}{13}{figure.caption.20}\protected@file@percent }
\newlabel{fig:roi_dominance}{{4}{13}{\textbf {Quantifying noun and verb sensitivity across language-selective regions of interest (ROIs).} Each point represents the mean $\Delta r = r_\text {baseline} - r_\text {masked}$ within significant voxels ($p<0.05$, FDR corrected) with $\Delta r \geq 0$, for noun-masked (\textbf {blue}) and verb-masked (\textbf {orange}) models, then averaged across participants. Error bars represent $\pm 1$ SEM across eight participants (S1--S9, excluding S4). ROIs are ordered by their mean $\Delta r$ in the listening modality}{figure.caption.20}{}}
